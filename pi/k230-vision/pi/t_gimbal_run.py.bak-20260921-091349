FAILS = []


def chk(cond, label):
    print(("  ok    " if cond else "  FAIL  ") + label)
    if not cond:
        FAILS.append(label)


def chk_eq(got, want, label):
    chk(got == want, "%s（期望 %r，实得 %r）" % (label, want, got))


