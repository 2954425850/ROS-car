#!/usr/bin/env python3
"""K230 视觉链路的 Pi 侧命令行。

    k230ctl snap [-o FILE] [--min-frames N] [--timeout S] [--attempts N] [--proto tcp|udp] [--json]
    k230ctl resultd                 前台常驻收结果（给 systemd 用）
    k230ctl result [--json]         打印最近一条视觉结果
    k230ctl status [--json]         汇总 resultd / 照片 的状态

    k230ctl follow WHO [--json]     跟着某个人（板子自己把脸绑到 person 框上；要等他露正脸）
    k230ctl auto [--json]           切回"检测器自动锁定"
    k230ctl stop [--json]           停止跟踪（释放当前目标）
    k230ctl pt U V [--size S]       指定一个点（归一化），板子自动开方框并跟住
    k230ctl box L T R B             直接给一个归一化框

    k230ctl config [--json]         看板子当前 WiFi SSID / 接收端地址（8558）
    k230ctl config --result-host H --push-host H
                                    改地址（落 config_remote.json，重启后仍生效）
    k230ctl config --wifi-ssid S --wifi-pass P
                                    换 WiFi（失败板子自动回滚；换网后 IP 可能变）
    k230ctl config --clear          删远程配置（重启后回到 config_local）

    k230ctl switch-net --ssid NEW [--password P] [--new-host IP]
                                    换 WiFi 时把 K230 的 WiFi + 指向一起迁过去
                                    （默认转到后台；日志 /tmp/k230/switch-net-*.log）

`snap` 成功时把最终 JPEG 的路径打到 stdout（退出码 0），失败打原因到 stderr（退出码 1）。
默认输出「只有一行路径」，方便 shell 直接取用：  IMG=$(k230ctl snap)
"""
import argparse
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import k230pi  # noqa: E402


def cmd_snap(args):
    try:
        r = k230pi.snap(out=args.out, min_frames=args.min_frames,
                        timeout=args.timeout, proto=args.proto,
                        attempts=args.attempts)
    except k230pi.SnapError as e:
        print("SNAP FAILED: %s" % e, file=sys.stderr)
        return 1
    if r["suspect"]:
        # 文件照样给，但要让调用方知道他拿到的东西可能不可靠（没攒够一整个 GOP）
        print("WARN 只攒到 %d 帧（< %d），未必跨过 IDR，画面可能不可靠"
              % (r["frames"], args.min_frames), file=sys.stderr)
    if args.json:
        print(json.dumps(r, ensure_ascii=False))
    else:
        print(r["path"])
    return 0


def cmd_framed(args):
    k230pi.framed()
    return 0


def cmd_resultd(args):
    k230pi.resultd()
    return 0


def cmd_result(args):
    obj = k230pi.read_latest_result()
    if obj is None:
        print("还没有收到任何结果（%s 不存在或为空）" % k230pi.LATEST_RESULT,
              file=sys.stderr)
        return 1
    if args.json:
        print(json.dumps(obj, ensure_ascii=False))
        return 0
    objs = obj.get("objs") or []
    print("frame=%s  w=%s h=%s  objs=%d  recv=%s  peer=%s"
          % (obj.get("frame"), obj.get("w"), obj.get("h"), len(objs),
             obj.get("_received_at"), obj.get("_peer")))
    for o in objs:
        print("  %-12s %.3f %s" % (o.get("cls"), o.get("score", 0), o.get("box")))
    return 0


def _send(payload, args):
    """把一条目标命令发给 K230 并打印应答。**一次连接一条。**"""
    try:
        r = k230pi.send_target(payload)
    except k230pi.TargetError as e:
        print("TARGET FAILED: %s" % e, file=sys.stderr)
        return 1
    if args.json:
        print(json.dumps(r, ensure_ascii=False))
    elif r.get("ok"):
        print("ok")
    else:
        print("err: %s" % r.get("err"), file=sys.stderr)
        return 1
    return 0


def cmd_follow(args):
    who = k230pi.resolve_who(args.who)
    if who != args.who:
        print("（%s -> %s）" % (args.who, who))
    return _send({"cmd": "follow", "who": who}, args)


def cmd_enroll(args):
    """录入画面里的那张脸为 <id>。板子回 ok 只是受理；等 8556 里的 enroll 结果。"""
    rc = _send({"cmd": "enroll", "id": args.id}, args)
    if rc or args.no_wait:
        return rc
    return _wait_enroll(args.id, "enroll", timeout=args.timeout)


def cmd_forget(args):
    rc = _send({"cmd": "forget", "id": args.id}, args)
    if rc or args.no_wait:
        return rc
    return _wait_enroll(args.id, "forget", timeout=5.0)


def _wait_enroll(pid, what, timeout):
    import time
    t_end = time.time() + timeout
    while time.time() < t_end:
        st = (k230pi.read_latest_result() or {}).get("enroll") or {}
        if st.get("id") == pid and st.get("cmd") == what and st.get("state") in ("done", "fail"):
            print("%s %s: %s  n=%s  %s" % (what, pid, st["state"], st.get("n"), st.get("why") or ""))
            return 0 if st["state"] == "done" else 1
        time.sleep(0.2)
    print("%s %s: 等结果超时（%.0fs）" % (what, pid, timeout), file=sys.stderr)
    return 1


def cmd_auto(args):
    return _send({"cmd": "auto"}, args)


def cmd_stop(args):
    return _send({"cmd": "stop"}, args)


def cmd_pt(args):
    payload = {"pt": [args.u, args.v]}
    if args.size is not None:
        payload["size"] = args.size
    return _send(payload, args)


def cmd_box(args):
    return _send({"box": [args.l, args.t, args.r, args.b]}, args)


def _print_config(r):
    c = r.get("config") or {}
    print("board %s" % r.get("ip"))
    print("  wifi_ssid     = %s  (%s)"
          % (c.get("wifi_ssid"),
             "password set" if c.get("wifi_pass_set") else "NO password"))
    print("  push_host     = %s" % c.get("push_host"))
    print("  result_host   = %s" % c.get("result_host"))
    ob = c.get("obstacle_host")
    print("  obstacle_host = %s"
          % ("(follow result_host)" if ob is None else ob))
    rk = r.get("remote_keys") or []
    print("remote override: %s" % (", ".join(rk) if rk else "(none)"))
    la = r.get("last_apply")
    if la:
        print("last_apply: t=%s ok=%s %s"
              % (la.get("t"), la.get("ok"), la.get("detail") or ""))


def cmd_config(args):
    if args.clear:
        payload = {"cmd": "config_clear"}
    else:
        payload = {"cmd": "config_set"}
        if args.wifi_ssid is not None:
            payload["wifi_ssid"] = args.wifi_ssid
        if args.wifi_pass is not None:
            payload["wifi_pass"] = args.wifi_pass
        if args.push_host is not None:
            payload["push_host"] = args.push_host
        if args.result_host is not None:
            payload["result_host"] = args.result_host
        if args.obstacle_host is not None:
            # 空串 = 跟随 result_host（显式写出来，别靠"没给这个参数"）
            payload["obstacle_host"] = args.obstacle_host or None
        if len(payload) == 1:            # 什么都没给 -> 只查
            payload = {"cmd": "config_get"}
    try:
        r = k230pi.send_config(payload, host=args.host)
    except k230pi.ConfigError as e:
        print("CONFIG FAILED: %s" % e, file=sys.stderr)
        return 1
    if args.json:
        print(json.dumps(r, ensure_ascii=False))
        return 0 if r.get("ok") else 1
    if not r.get("ok"):
        print("err: %s" % r.get("err"), file=sys.stderr)
        return 1
    if payload["cmd"] == "config_get":
        _print_config(r)
    else:
        print("ok%s" % (" —— %s" % r["note"] if r.get("note") else ""))
        accepted = r.get("accepted") or []
        if accepted:
            print("accepted: %s" % ", ".join(accepted))
    return 0


def cmd_switch_net(args):
    """Pi 换 WiFi 时，把 K230 的 WiFi 与指向地址一起迁过去。

    **默认后台执行**：换 WiFi 会把 SSH（或本地终端所在的那条会话）一起断掉，
    前台跑的话进程会跟着死。为什么不用 SSH_CONNECTION 判断：`sudo` 默认会
    清掉这个环境变量，判断不可靠 —— 与其猜，不如默认安全，真要盯着就 --foreground。
    """
    import switchnet
    pw = args.password if args.password is not None \
        else os.environ.get("K230_WIFI_PASS")
    if args.foreground:
        return switchnet.run(ssid=args.ssid, password=pw,
                             new_host=args.new_host, timeout=args.timeout,
                             pi_timeout=args.pi_timeout, iface=args.iface,
                             hidden=args.hidden,
                             no_pi_switch=args.no_pi_switch,
                             board_host=args.board_host,
                             board_new_host=args.board_new_host, log=print)
    try:
        hint = switchnet.permission_hint()
    except switchnet.SwitchError:
        hint = None
    if hint:
        # **不往下走**：先把板子弄到新网、Pi 却换不过去 = 两边失联。
        print("nmcli 的 network-control 权限是 %r（不是 yes）—— 现在换 WiFi 多半会失败。\n"
              "请用 `sudo k230ctl switch-net ...` 重跑（sudo 下这个检查会通过）。"
              % hint, file=sys.stderr)
        return 1
    log_path = switchnet.detach(sys.argv[1:])
    print("已在后台执行（换 WiFi 会断开当前连接）。日志：%s" % log_path)
    print("跟踪进度：tail -f %s" % log_path)
    print("完成后看：k230ctl config")
    return 0


def cmd_status(args):
    st = k230pi.read_status()
    age = k230pi.status_age_s()
    jpg = k230pi.LATEST_JPEG
    if args.json:
        print(json.dumps({"resultd": st, "status_age_s": age,
                          "latest_jpeg": jpg,
                          "latest_jpeg_bytes": (os.path.getsize(jpg)
                                                if os.path.exists(jpg) else None)},
                         ensure_ascii=False))
        return 0 if st else 1
    rc = 0
    if st is None:
        print("resultd: 未运行（%s 不存在）" % k230pi.STATUS_FILE)
        rc = 1
    else:
        print("resultd: pid=%s listening=%s connected=%s peer=%s connects=%s "
              "msgs=%s bad_lines=%s last_frame=%s last_objs=%s last_msg=%s "
              "status_age=%ss"
              % (st.get("pid"), st.get("listening"), st.get("connected"),
                 st.get("peer"), st.get("connects"), st.get("msgs"),
                 st.get("bad_lines"), st.get("last_frame"), st.get("last_objs"),
                 st.get("last_msg"), age))
        if age is not None and age > 30:
            print("  ⚠ 状态文件 %ss 没更新 —— 守护进程可能已经死了" % age)
            rc = 1
    print("latest.jpg: %s"
          % (("%s (%d B)" % (jpg, os.path.getsize(jpg)))
             if os.path.exists(jpg) else "无（还没拍过）"))
    return rc


def main(argv=None):
    ap = argparse.ArgumentParser(prog="k230ctl")
    sub = ap.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("snap", help="从 K230 抓一张 JPEG")
    s.add_argument("-o", "--out", default=None,
                   help="输出路径（默认 /tmp/k230/snap-<时间戳>.jpg）")
    s.add_argument("--min-frames", type=int, default=k230pi.MIN_FRAMES,
                   help="攒够多少帧才收工（默认 %d，别低于 %d）"
                        % (k230pi.MIN_FRAMES, k230pi.GOP_LEN + 1))
    s.add_argument("--timeout", type=float, default=k230pi.DEFAULT_TIMEOUT,
                   help="单次尝试的墙钟上限秒数（默认 %.0f）" % k230pi.DEFAULT_TIMEOUT)
    s.add_argument("--attempts", type=int, default=k230pi.DEFAULT_ATTEMPTS,
                   help="失败重试次数（默认 %d）" % k230pi.DEFAULT_ATTEMPTS)
    s.add_argument("--proto", choices=["tcp", "udp"], default="tcp")
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_snap)

    d = sub.add_parser("resultd", help="前台常驻收 K230 结果（给 systemd 用）")
    d.set_defaults(func=cmd_resultd)

    fr = sub.add_parser("framed", help="常驻：收板子推来的 H.264(8555)，留最新关键帧给 snap")
    fr.set_defaults(func=cmd_framed)

    q = sub.add_parser("result", help="打印最近一条视觉结果")
    q.add_argument("--json", action="store_true")
    q.set_defaults(func=cmd_result)

    t = sub.add_parser("status", help="汇总 resultd / 照片 的状态")
    t.add_argument("--json", action="store_true")
    t.set_defaults(func=cmd_status)

    f = sub.add_parser("follow", help="跟着某个人（要等他露正脸，最多几秒）")
    f.add_argument("who", help="faces 里的名字，如 id1")
    f.add_argument("--json", action="store_true")
    f.set_defaults(func=cmd_follow)

    en = sub.add_parser("enroll", help="把画面里唯一那张脸录成 <id>（ASCII），等结果")
    en.add_argument("id")
    en.add_argument("--timeout", type=float, default=10.0)
    en.add_argument("--no-wait", action="store_true")
    en.add_argument("--json", action="store_true")
    en.set_defaults(func=cmd_enroll)

    fg = sub.add_parser("forget", help="从板子人脸库删掉 <id>")
    fg.add_argument("id")
    fg.add_argument("--no-wait", action="store_true")
    fg.add_argument("--json", action="store_true")
    fg.set_defaults(func=cmd_forget)

    au = sub.add_parser("auto", help='切回"检测器自动锁定"')
    au.add_argument("--json", action="store_true")
    au.set_defaults(func=cmd_auto)

    sp = sub.add_parser("stop", help="停止跟踪（释放当前目标）")
    sp.add_argument("--json", action="store_true")
    sp.set_defaults(func=cmd_stop)

    pt = sub.add_parser("pt", help="指定一个点（归一化 u v），板子自动开方框并跟住")
    pt.add_argument("u", type=float)
    pt.add_argument("v", type=float)
    pt.add_argument("--size", type=float, default=None,
                    help="方框边长占画面宽度的比例（默认由板子决定，约 0.12）")
    pt.add_argument("--json", action="store_true")
    pt.set_defaults(func=cmd_pt)

    bx = sub.add_parser("box", help="直接给一个归一化框 [l t r b]")
    bx.add_argument("l", type=float)
    bx.add_argument("t", type=float)
    bx.add_argument("r", type=float)
    bx.add_argument("b", type=float)
    bx.add_argument("--json", action="store_true")
    bx.set_defaults(func=cmd_box)

    cf = sub.add_parser(
        "config", help="查看/修改板子的 WiFi 与接收端地址（8558，落 config_remote.json）")
    cf.add_argument("--wifi-ssid", help="要连的 WiFi 名")
    cf.add_argument("--wifi-pass",
                    help="WiFi 密码（8..63 字符；开放网络给空串）")
    cf.add_argument("--push-host", help="推流(8555)/结果(8556)/避障(8559)的目标 IP")
    cf.add_argument("--result-host", help="结构化结果上报目标 IP")
    cf.add_argument("--obstacle-host", default=None,
                    help='避障数据目标 IP；空串 = 跟随 result_host')
    cf.add_argument("--clear", action="store_true",
                    help="删掉远程配置（运行时不变，重启后回到 config_local）")
    cf.add_argument("--host", default=None, help="K230 地址（默认自动发现）")
    cf.add_argument("--json", action="store_true")
    cf.set_defaults(func=cmd_config)

    sn = sub.add_parser(
        "switch-net",
        help="Pi 换 WiFi 时，把 K230 的 WiFi 和指向地址一起迁过去")
    sn.add_argument("--ssid", required=True,
                    help="目标 WiFi 名（Pi 和 K230 都要连的那个）")
    sn.add_argument("--password",
                    help="目标 WiFi 密码（也可用环境变量 K230_WIFI_PASS；"
                         "不给则只改 SSID，密码沿用板子现有的）")
    sn.add_argument("--new-host",
                    help="Pi 在目标网的固定 IP（有 DHCP 保留就给，最稳；"
                         "不给就切完后在新网扫描找板子）")
    sn.add_argument("--board-host", help="K230 当前（旧网）地址，默认自动发现")
    sn.add_argument("--board-new-host",
                    help="K230 在目标网的地址（DHCP 保留时可用，省掉扫描；"
                         "非 /24 网段或扫描被隔离时也该给）")
    sn.add_argument("--iface", help="Pi 的 WiFi 接口名（默认自动取已连接的）")
    sn.add_argument("--hidden", action="store_true", help="目标 WiFi 是隐藏 SSID")
    sn.add_argument("--no-pi-switch", action="store_true",
                    help="Pi 由你自己换网，本命令只安排 K230、之后等 Pi 换过去")
    sn.add_argument("--timeout", type=float, default=90.0,
                    help="在新网找板子的时限（秒，默认 90）")
    sn.add_argument("--pi-timeout", type=float, default=25.0,
                    help="等 Pi 拿到新地址的时限（秒，默认 25）")
    sn.add_argument("--foreground", action="store_true",
                    help="前台跑（SSH 会随换网断开；本地终端才这么用）")
    sn.set_defaults(func=cmd_switch_net)

    a = ap.parse_args(argv)
    return a.func(a)


if __name__ == "__main__":
    sys.exit(main())
