def cmd_resultd(args):
    k230pi.resultd()
    return 0


def cmd_result(args):
    obj = k230pi.read_latest_result()
    if obj is None:
        print("还没有收到任何结果（%s 不存在或为空）" % k230pi.LATEST_RESULT,
              file=sys.stderr)
        return 1
    if args.json:
        print(json.dumps(obj, ensure_ascii=False))
    else:
        objs = obj.get("objs") or []
        print("frame=%s  w=%s h=%s  objs=%d  recv=%s  peer=%s"
              % (obj.get("frame"), obj.get("w"), obj.get("h"), len(objs),
                 obj.get("_received_at"), obj.get("_peer")))
        for o in objs:
            print("  %-12s %.3f %s" % (o.get("cls"), o.get("score"), o.get("box")))
    return 0


def cmd_status(args):
    import time as _t
    st = k230pi.read_status()
    rc = 0
    if st is None:
        print("resultd: 未运行（%s 不存在）" % k230pi.STATUS_FILE)
        rc = 1
    else:
        age = None
        try:
            age = round(_t.time() - os.path.getmtime(k230pi.STATUS_FILE), 1)
        except OSError:
            pass
        print("resultd: pid=%s listens=%s connected=%s peer=%s connects=%s msgs=%s "
              "bad_lines=%s last_frame=%s last_objs=%s last_msg=%s status_age=%ss"
              % (st.get("pid"), st.get("listening"), st.get("connected"),
                 st.get("peer"), st.get("connects"), st.get("msgs"),
                 st.get("bad_lines"), st.get("last_frame"), st.get("last_objs"),
                 st.get("last_msg"), age))
        if age is not None and age > 30:
            print("  ⚠ 状态文件 %ss 没更新 —— 守护进程可能已死" % age)
            rc = 1
    jpg = k230pi.LATEST_JPEG
    print("latest.jpg: %s" % (("%s (%d B)" % (jpg, os.path.getsize(jpg)))
                              if os.path.exists(jpg) else "无"))
    return rc
