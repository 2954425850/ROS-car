# /sdcard/k230vision/cam.py
"""sensor + 硬件编码通道。

## 为什么用 MediaManager.link 而不是 SendFrame

MediaManager.link 把 sensor 直接绑到编码器（零拷贝），是 rtsp_server.py 例程的
做法，CPU 开销最低。SendFrame 模式需要先把帧搬到 Python 侧，多一次拷贝，
只在"要编码显示回写缓冲"时才需要（WBCRtsp 那种）。
"""
from media.sensor import *
from media.media import *
from media.vencoder import *


class Camera:
    def __init__(self, chn, width=1280, height=720, bitrate_kbps=2048):
        self.chn = chn
        self.width = ALIGN_UP(width, 16)
        self.height = height
        self.bitrate_kbps = bitrate_kbps
        self.sensor = None
        self.encoder = None
        self.link = None

    def start(self):
        self.sensor = Sensor()
        self.sensor.reset()
        self.sensor.set_framesize(width=self.width, height=self.height, alignment=12)
        self.sensor.set_pixformat(Sensor.YUV420SP)

        self.encoder = Encoder()
        self.encoder.SetOutBufs(self.chn, 8, self.width, self.height)
        chn_attr = ChnAttrStr(
            self.encoder.PAYLOAD_TYPE_H264,
            self.encoder.H264_PROFILE_MAIN,
            self.width,
            self.height,
            bit_rate=self.bitrate_kbps,
        )
        self.encoder.Create(self.chn, chn_attr)

        self.link = MediaManager.link(
            self.sensor.bind_info()["src"],
            (VIDEO_ENCODE_MOD_ID, VENC_DEV_ID, self.chn),
        )
        self.encoder.Start(self.chn)
        self.sensor.run()

    def stop(self):
        if self.sensor:
            self.sensor.stop()
        if self.link:
            del self.link
            self.link = None
        if self.encoder:
            self.encoder.Stop(self.chn)
            self.encoder.Destroy(self.chn)
            self.encoder = None
```

