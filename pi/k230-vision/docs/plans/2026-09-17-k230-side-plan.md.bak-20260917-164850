# /sdcard/k230vision/cam.py（多通道版）
"""sensor + 多个硬件编码通道。

一路 sensor 可以同时绑到多个 VENC 通道（VENC 共 4 个通道，见 media.vencoder
的 VENC_CHN_ID_0..3）。chn0 给云端推流，chn1 给局域网 RTSP。
"""
from media.sensor import *
from media.media import *
from media.vencoder import *


class Camera:
    def __init__(self, width=1280, height=720):
        self.width = ALIGN_UP(width, 16)
        self.height = height
        self.sensor = None
        self._chans = {}          # chn -> {"enc": Encoder, "link": ..., "bitrate": int}
        self._started = False

    def add_channel(self, chn, bitrate_kbps=2048):
        """必须在 start() 之前调用。"""
        if self._started:
            raise RuntimeError("add_channel 必须在 start() 之前")
        self._chans[chn] = {"enc": None, "link": None, "bitrate": bitrate_kbps}

    def start(self):
        self.sensor = Sensor()
        self.sensor.reset()
        self.sensor.set_framesize(width=self.width, height=self.height, alignment=12)
        self.sensor.set_pixformat(Sensor.YUV420SP)

        for chn, c in self._chans.items():
            enc = Encoder()
            enc.SetOutBufs(chn, 8, self.width, self.height)
            attr = ChnAttrStr(
                enc.PAYLOAD_TYPE_H264, enc.H264_PROFILE_MAIN,
                self.width, self.height, bit_rate=c["bitrate"],
            )
            enc.Create(chn, attr)
            c["enc"] = enc
            c["link"] = MediaManager.link(
                self.sensor.bind_info()["src"],
                (VIDEO_ENCODE_MOD_ID, VENC_DEV_ID, chn),
            )

        for chn, c in self._chans.items():
            c["enc"].Start(chn)
        self.sensor.run()
        self._started = True

    def encoder(self, chn):
        return self._chans[chn]["enc"]

    def request_idr(self, chn):
        """丢帧/重连后调用，让流尽快恢复。"""
        try:
            self._chans[chn]["enc"].RequestIDR(chn)
        except Exception:
            pass

    def stop(self):
        if self.sensor:
            try:
                self.sensor.stop()
            except Exception:
                pass
        for chn, c in self._chans.items():
            if c["link"]:
                try:
                    del c["link"]
                except Exception:
                    pass
                c["link"] = None
            if c["enc"]:
                try:
                    c["enc"].Stop(chn)
                    c["enc"].Destroy(chn)
                except Exception:
                    pass
                c["enc"] = None
        self._started = False
```

