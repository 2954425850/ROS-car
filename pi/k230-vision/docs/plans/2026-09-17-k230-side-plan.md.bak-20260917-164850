# /sdcard/k230vision/reporter.py
"""结构化结果上报。

## 为什么不排队

结果只有几 KB/s，但网络可能瞬断。排队同样会吃掉 MicroPython 那 3.9 MB 堆。
发不出去就丢弃这一条 —— 结果流是"最新的才有意义"，不是可靠传输。
"""
import socket


class Reporter:
    def __init__(self, host, port, send_timeout_s=0.2):
        self.host = host
        self.port = port
        self.send_timeout_s = send_timeout_s
        self.sock = None
        self.sent = 0
        self.dropped = 0

    def connect(self):
        self.close()
        try:
            s = socket.socket()
            s.settimeout(self.send_timeout_s)
            s.connect((self.host, self.port))
            self.sock = s
            return True
        except OSError:
            self.sock = None
            return False

    def close(self):
        if self.sock:
            try: self.sock.close()
            except OSError: pass
            self.sock = None

    @property
    def ok(self):
        return self.sock is not None

    def send(self, payload):
        """payload 不含换行；本函数补上换行做为消息边界。"""
        if not self.ok:
            self.dropped += 1
            return False
        try:
            self.sock.send(payload + b"\n")
            self.sent += 1
            return True
        except OSError:
            self.dropped += 1
            self.close()
            return False
```

