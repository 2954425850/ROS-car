```python
# /sdcard/k230vision/app.py
"""主循环：WiFi -> 摄像头(2 通道) -> 推流 + RTSP + 推理 + 结果上报。

## 单线程编排

MicroPython 的 _thread 在这块板子上与 MPP 的配合没验证过，**不要用多线程**。
所有"取一帧"的动作都是非阻塞的（timeout=0 或 100ms），在一个循环里轮流推进。
"""
import sys
import time

sys.path.insert(0, "/sdcard/k230vision")

import config
import netup
from cam import Camera
from pusher import Pusher
from rtsp_srv import RtspOut
from results import encode
from reporter import Reporter
from watchdog import Watchdog
from libs.PipeLine import PipeLine
from vision import Detector


def main():
    netup.init(config.WIFI_SSID, config.WIFI_PASS)
    while not netup.connect():
        print("WIFI FAILED, retry")
        time.sleep(2)

    cam = Camera(config.WIDTH, config.HEIGHT)
    cam.add_channel(config.PUSH_CHN, config.BITRATE_KBPS)
    cam.add_channel(config.RTSP_CHN, config.BITRATE_KBPS)
    cam.start()
    print("CAM OK")

    pusher = Pusher(config.PUSH_HOST, config.PUSH_PORT,
                    cam.encoder(config.PUSH_CHN), config.PUSH_CHN)
    rtsp = RtspOut(cam.encoder(config.RTSP_CHN), config.RTSP_CHN,
                   config.RTSP_PORT, config.RTSP_SESSION,
                   config.WIDTH, config.HEIGHT)
    rtsp.start()
    print("RTSP", rtsp.get_url())

    r_pi = Reporter(config.RESULT_HOST, config.RESULT_PORT)
    r_cloud = None
    if config.CLOUD_RESULT_HOST:
        r_cloud = Reporter(config.CLOUD_RESULT_HOST, config.CLOUD_RESULT_PORT)

    wd = Watchdog(config.PUSH_STALL_WARN_MS)
    frame_no = 0
    last_infer = 0.0
    last_report = 0.0

    try:
        while True:
            # 1) 推流：每轮尽量取，不空转
            rc = pusher.pump()
            if rc == -2:
                time.sleep(config.RECONNECT_BACKOFF_MS / 1000)
                if pusher.connect():
                    cam.request_idr(config.PUSH_CHN)
            elif rc == 0:
                wd.tick(pusher.frames_sent)

            # 2) RTSP 通道
            rtsp.pump()

            # 3) 推理（限流到 ~10 Hz，别把 CPU 吃满）
            now = time.time()
            if now - last_infer >= 0.1:
                last_infer = now
                frame_no += 1

            # 4) 上报（10 Hz）
            if now - last_report >= 0.1:
                last_report = now
                payload = encode(_last_objs, config.WIDTH, config.HEIGHT,
                                 frame_no, int(now * 1000))
                if not r_pi.ok:
                    r_pi.connect()
                r_pi.send(payload)
                if r_cloud is not None:
                    if not r_cloud.ok:
                        r_cloud.connect()
                    r_cloud.send(payload)

            if wd.stalled:
                print("WARN push stalled")
    finally:
        pusher.close()
        rtsp.stop()
        cam.stop()


_last_objs = []


if __name__ == "__main__":
    main()
```

**注意**：上面第 3 步只推进了帧号，真正的 `det.detect(img)` 需要接 `PipeLine` 的取帧 —— **在 Step 2 里按实测的 PipeLine 用法补齐**（`PipeLine` 与"直接 `MediaManager.link` 的 sensor"能否共存，是本任务要验证的第二个点）。

