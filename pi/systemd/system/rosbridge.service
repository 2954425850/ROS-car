[Unit]
Description=ROS 2 rosbridge WebSocket
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cy
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && source /home/cy/ROS-car/pi/l150pro_ws/install/setup.bash && exec ros2 launch rosbridge_server rosbridge_websocket_launch.xml address:=127.0.0.1 port:=9090'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
