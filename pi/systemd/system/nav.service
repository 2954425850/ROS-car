[Unit]
Description=nepu navigation (AMCL + nav2, no in-place rotation)
After=network-online.target ps2-teleop.service
Wants=network-online.target
# Navigation and mapping both publish map->odom; never run them together.
Conflicts=slam.service

[Service]
Type=simple
User=cy
Environment=HOME=/home/cy
WorkingDirectory=/home/cy/ros2_lidar
ExecStart=/bin/bash -c 'source /opt/ros/jazzy/setup.bash && exec ros2 launch /home/cy/ros2_lidar/launch/nav.launch.py'
Restart=on-failure
RestartSec=5
KillMode=control-group

[Install]
WantedBy=multi-user.target
