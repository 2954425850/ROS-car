[Unit]
Description=QQ音乐 cookie 续期（key 只有 72 小时寿命，到期前滚动刷新）
Documentation=file:///home/cy/voice-chatbot/tools/qq_login.py

[Service]
Type=oneshot
WorkingDirectory=/home/cy/voice-chatbot
Environment=PATH=/home/cy/.local/bin:/usr/local/bin:/usr/bin:/bin
# 注意：这个脚本成功时会**重启 voice-chatbot** —— 因为 QQ_MUSIC_COOKIE 是
# MCP 子进程启动时的环境变量，不重启就还是旧 key。凌晨跑，不打扰人。
ExecStart=/usr/bin/python3 /home/cy/voice-chatbot/tools/qq_login.py refresh
